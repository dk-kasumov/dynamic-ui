# Editor configuration, see https://editorconfig.org
# Keep in sync with .prettierrc — Prettier also reads this file for options it does not set itself.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Two trailing spaces are a hard line break in Markdown
max_line_length = off
trim_trailing_whitespace = false
